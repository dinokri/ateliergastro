rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'dinokrickovic555@gmail.com'
      );
    }

    // 1. Restaurant Settings
    match /restaurantSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingsId);
    }

    // 2. Menu Categories
    match /menuCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    // 3. Menu Items
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(itemId);
    }

    // 4. Promotions & Coupons
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(promoId);
    }

    // 5. Orders
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if isAdmin();
      allow create: if isValidId(orderId) &&
        incoming().orderNumber is string &&
        incoming().orderNumber.size() > 0 &&
        incoming().orderNumber.size() <= 64 &&
        incoming().customerName is string &&
        incoming().customerName.size() > 0 &&
        incoming().customerName.size() <= 100 &&
        incoming().customerPhone is string &&
        incoming().customerPhone.size() > 0 &&
        incoming().customerPhone.size() <= 50 &&
        incoming().items is list &&
        incoming().items.size() > 0 &&
        incoming().items.size() <= 100 &&
        incoming().total is number &&
        incoming().total >= 0;
      allow update, delete: if isAdmin() && isValidId(orderId);
    }

    // 6. Reservations
    match /reservations/{reservationId} {
      allow get: if isValidId(reservationId);
      allow list: if isAdmin();
      allow create: if isValidId(reservationId) &&
        incoming().reservationNumber is string &&
        incoming().reservationNumber.size() > 0 &&
        incoming().reservationNumber.size() <= 64 &&
        incoming().customerName is string &&
        incoming().customerName.size() > 0 &&
        incoming().customerName.size() <= 100 &&
        incoming().customerPhone is string &&
        incoming().customerPhone.size() > 0 &&
        incoming().customerPhone.size() <= 50 &&
        incoming().customerEmail is string &&
        incoming().customerEmail.size() > 0 &&
        incoming().customerEmail.size() <= 100 &&
        incoming().date is string &&
        incoming().date.size() > 0 &&
        incoming().time is string &&
        incoming().time.size() > 0 &&
        incoming().guests is number &&
        incoming().guests > 0 &&
        incoming().guests <= 100;
      allow update, delete: if isAdmin() && isValidId(reservationId);
    }

    // 7. Event Inquiries
    match /eventInquiries/{inquiryId} {
      allow list: if isAdmin();
      allow get: if isAdmin() && isValidId(inquiryId);
      allow create: if isValidId(inquiryId) &&
        incoming().fullName is string &&
        incoming().fullName.size() > 0 &&
        incoming().fullName.size() <= 100 &&
        incoming().email is string &&
        incoming().email.size() > 0 &&
        incoming().email.size() <= 100 &&
        incoming().phone is string &&
        incoming().phone.size() > 0 &&
        incoming().phone.size() <= 50;
      allow update, delete: if isAdmin() && isValidId(inquiryId);
    }

    // 8. Newsletter Subscribers
    match /newsletterSubscribers/{subId} {
      allow list: if isAdmin();
      allow get: if isAdmin() && isValidId(subId);
      allow create: if isValidId(subId) &&
        incoming().email is string &&
        incoming().email.size() > 0 &&
        incoming().email.size() <= 100 &&
        incoming().consentGiven == true;
      allow delete: if isAdmin() && isValidId(subId);
    }

    // 9. Admin users
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(uid);
    }
  }
}
